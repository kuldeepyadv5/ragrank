# LLM Provider — local Ollama (recommended if running qwen3:8b locally)
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_THINK=false
LLM_TIMEOUT=600
LLM_MAX_TOKENS=512

# Cloud Qwen via DashScope (optional)
# LLM_PROVIDER=qwen
# DASHSCOPE_API_KEY=
# LLM_MODEL=qwen-plus
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Reranker
# Options: distilbert-base-uncased | cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_MODEL=distilbert-base-uncased
RERANKER_LOSS=bce
RERANKER_MARGIN=0.5
RERANKER_EPOCHS=3
RERANKER_LR=2e-5
RERANKER_BATCH_SIZE=16
# INT8 on CPU (~4x smaller/faster); FP16 on CUDA when RERANKER_FP16_CUDA=true
RERANKER_QUANTIZE=true
RERANKER_FP16_CUDA=true

# Retriever
# Options: sentence-transformers/all-MiniLM-L6-v2 | sentence-transformers/all-mpnet-base-v2
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=512
CHUNK_OVERLAP=64
RETRIEVAL_TOP_K=20
RERANK_TOP_K=5
FAISS_USE_IVF=false
EMBEDDING_QUANTIZE=true
EMBEDDING_BATCH_SIZE=32

# Experiment Tracking
TRACKING_BACKEND=mlflow
MLFLOW_TRACKING_URI=./data/mlruns
MLFLOW_EXPERIMENT=rag-reranker

# App
API_HOST=0.0.0.0
API_PORT=8000
STREAMLIT_PORT=8501
API_BASE_URL=http://localhost:8000
API_CLIENT_TIMEOUT=600
DASHBOARD_API_DEBUG=true
API_WORKFLOW_DEBUG=true
