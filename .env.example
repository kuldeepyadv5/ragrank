# LLM Provider — Qwen (recommended)
# python run.py api
# python run.py dashboard
# python run.py train
# python -m src.reranker.train --loss margin_mse

LLM_PROVIDER=qwen
DASHSCOPE_API_KEY=
# QWEN_API_KEY=              # alias for DASHSCOPE_API_KEY
LLM_MODEL=qwen-plus
# Other Qwen models: qwen-turbo | qwen-max | qwen2.5-72b-instruct | qwen2.5-7b-instruct
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Legacy providers (optional)
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Reranker
# Options: distilbert-base-uncased | cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_MODEL=distilbert-base-uncased
RERANKER_LOSS=bce
RERANKER_MARGIN=0.5
RERANKER_EPOCHS=3
RERANKER_LR=2e-5

# Retriever
# Options: sentence-transformers/all-MiniLM-L6-v2 | sentence-transformers/all-mpnet-base-v2
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=512
CHUNK_OVERLAP=64
RETRIEVAL_TOP_K=20
RERANK_TOP_K=5
FAISS_USE_IVF=false

# Experiment Tracking
TRACKING_BACKEND=mlflow
MLFLOW_TRACKING_URI=./data/mlruns
MLFLOW_EXPERIMENT=rag-reranker

# App
API_HOST=0.0.0.0
API_PORT=8000
STREAMLIT_PORT=8501
API_BASE_URL=http://localhost:8000
